schema_version: 1

harness:
  name: compass-harness
  version: 0.4.0

project:
  name: "{{PROJECT_NAME}}"

canonical_root: .compass-harness
project_rules: AGENTS.md
canonical_paths:
  config: .compass-harness/config.yaml
  context: .compass-harness/context
  skills: .compass-harness/skills
  subagents: .compass-harness/subagents

generated_adapters:
  - CLAUDE.md
  - opencode.json
  - .agents/skills
  - .claude/skills
  - .codex/agents
  - .claude/agents
  - .opencode/agents
