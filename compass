#!/usr/bin/env bash
# compass — Compass Harness 中控台
# 用法: compass [command] [args...]
#
# 在一个终端里查看全局状态、分发 skill 到不同 agent/terminal。
# 每个 skill 由独立的 agent（Claude Code / Copilot / Cline）在独立终端执行。
# 本脚本负责：状态总览、下一步建议、启动提示词生成。

set -euo pipefail

# ─── 配置 ────────────────────────────────────────────────────────────
AI_DIR=".ai"
SPECS_DIR="$AI_DIR/L3-specs"
CHANGES_DIR="$SPECS_DIR/changes"
ARCHIVE_DIR="$SPECS_DIR/archive"
SESSION_FILE="$AI_DIR/L4-session/active-session.md"
TESTING_FILE="$AI_DIR/L2-rules/testing.md"
SKILLS_DIR=".github/skills"  # or "$AI_DIR/../.github/skills" depending on layout

# ─── 颜色 ────────────────────────────────────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
BOLD='\033[1m'
DIM='\033[2m'
NC='\033[0m' # No Color

# ─── 工具函数 ────────────────────────────────────────────────────────
header() {
    echo ""
    echo -e "${BOLD}${CYAN}━━━ $1 ━━━${NC}"
}

info()    { echo -e "  ${BLUE}ℹ${NC}  $1"; }
success() { echo -e "  ${GREEN}✅${NC} $1"; }
warn()    { echo -e "  ${YELLOW}⚠️${NC}  $1"; }
error()   { echo -e "  ${RED}❌${NC} $1"; }

# ─── 检查 .ai/ 是否存在 ──────────────────────────────────────────────
check_ai_dir() {
    if [[ ! -d "$AI_DIR" ]]; then
        error "当前目录没有 .ai/ — 请先运行 /build-ai 或 /init-project"
        exit 1
    fi
}

# ─── status: 全局状态总览 ─────────────────────────────────────────────
cmd_status() {
    check_ai_dir
    echo ""
    echo -e "${BOLD}${CYAN}╔══════════════════════════════════════════════╗${NC}"
    echo -e "${BOLD}${CYAN}║       🧭 Compass Harness — 状态总览         ║${NC}"
    echo -e "${BOLD}${CYAN}╚══════════════════════════════════════════════╝${NC}"

    # ── .ai/ 完整性
    header "📁 .ai/ 完整性"
    local missing=0
    for f in \
        "$AI_DIR/L1-codebase-map/overview.md" \
        "$AI_DIR/L2-rules/global.md" \
        "$TESTING_FILE" \
        "$AI_DIR/L3-specs/specs/system.md" \
        "$SESSION_FILE" \
        "$AI_DIR/L5-validation/validation-rules.md"; do
        if [[ -f "$f" ]]; then
            success "$f"
        else
            error "$f ${DIM}(缺失)${NC}"
            ((missing++)) || true
        fi
    done
    [[ $missing -eq 0 ]] && success "全部核心文件就位" || warn "$missing 个核心文件缺失"

    # ── 变更状态
    header "📋 变更状态"
    if [[ -d "$CHANGES_DIR" ]]; then
        local has_changes=0
        for d in "$CHANGES_DIR"/*/; do
            [[ "$(basename "$d")" == "_change-template" ]] && continue
            [[ ! -f "$d/proposal.md" ]] && continue
            has_changes=1
            local name
            name=$(basename "$d")
            local status
            status=$(grep -oP '(?<=status:\s).*' "$d/proposal.md" 2>/dev/null | head -1 || echo "unknown")
            # 检查最后修改时间
            local last_modified
            last_modified=$(find "$d" -name '*.md' -printf '%T@\n' 2>/dev/null | sort -rn | head -1 || echo "0")
            local days_ago=""
            if command -v python3 &>/dev/null && [[ "$last_modified" != "0" ]]; then
                days_ago=$(python3 -c "import time; d=int((time.time()-$last_modified)/86400); print(f' ({d}天前更新)') if d>0 else print(' (今天更新)')" 2>/dev/null || echo "")
            fi

            case "$status" in
                *implementing*) echo -e "  🔨 ${YELLOW}$name${NC} — implementing${DIM}$days_ago${NC}" ;;
                *pending-review*) echo -e "  👀 ${BLUE}$name${NC} — pending-review${DIM}$days_ago${NC}" ;;
                *review-failed*) echo -e "  🔴 ${RED}$name${NC} — review-failed${DIM}$days_ago${NC}" ;;
                *drafting*) echo -e "  📝 ${DIM}$name${NC} — drafting${DIM}$days_ago${NC}" ;;
                *approved*) echo -e "  ✅ ${GREEN}$name${NC} — approved (可归档)${DIM}$days_ago${NC}" ;;
                *) echo -e "  ❓ $name — $status${DIM}$days_ago${NC}" ;;
            esac
        done
        [[ $has_changes -eq 0 ]] && info "无进行中的变更"
    else
        info "无 changes/ 目录"
    fi

    # ── 归档统计
    if [[ -d "$ARCHIVE_DIR" ]]; then
        local archive_count
        archive_count=$(find "$ARCHIVE_DIR" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l | tr -d ' ')
        info "已归档: ${archive_count} 个变更"
    fi

    # ── 会话状态
    header "💾 会话状态"
    if [[ -f "$SESSION_FILE" ]]; then
        # 显示最近的 next actions
        local next_actions
        next_actions=$(sed -n '/[Nn]ext\|下一步\|待办/,/^##\|^---/p' "$SESSION_FILE" 2>/dev/null | head -5)
        if [[ -n "$next_actions" ]]; then
            echo -e "${DIM}$next_actions${NC}"
        else
            info "active-session.md 存在但未找到明确的 next actions"
        fi
    else
        warn "active-session.md 不存在"
    fi

    # ── 建议下一步
    header "💡 建议下一步"
    suggest_next_action

    echo ""
}

# ─── suggest: 智能推荐下一步 ──────────────────────────────────────────
suggest_next_action() {
    local has_review_failed=0
    local has_pending_review=0
    local has_implementing=0
    local has_drafting=0
    local has_approved=0
    local stale_changes=""

    if [[ -d "$CHANGES_DIR" ]]; then
        for d in "$CHANGES_DIR"/*/; do
            [[ "$(basename "$d")" == "_change-template" ]] && continue
            [[ ! -f "$d/proposal.md" ]] && continue
            local name
            name=$(basename "$d")
            local status
            status=$(grep -oP '(?<=status:\s).*' "$d/proposal.md" 2>/dev/null | head -1 || echo "")

            case "$status" in
                *review-failed*)  has_review_failed=1 ;;
                *pending-review*) has_pending_review=1 ;;
                *implementing*)   has_implementing=1 ;;
                *drafting*)       has_drafting=1 ;;
                *approved*)       has_approved=1 ;;
            esac

            # 检查 > 7 天未更新
            local last_ts
            last_ts=$(find "$d" -name '*.md' -printf '%T@\n' 2>/dev/null | sort -rn | head -1 || echo "0")
            if command -v python3 &>/dev/null && [[ "$last_ts" != "0" ]]; then
                local is_stale
                is_stale=$(python3 -c "import time; print('1' if (time.time()-$last_ts)>604800 else '0')" 2>/dev/null || echo "0")
                [[ "$is_stale" == "1" ]] && stale_changes="$stale_changes $name"
            fi
        done
    fi

    # 优先级排序
    if [[ $has_review_failed -eq 1 ]]; then
        echo -e "  ${RED}1.${NC} 有 review-failed 的变更 → 打开新终端，让 agent 执行 ${BOLD}/fix-bug${NC}"
    fi
    if [[ $has_approved -eq 1 ]]; then
        echo -e "  ${GREEN}2.${NC} 有 approved 的变更 → 打开新终端，让 agent 执行 ${BOLD}/archive-change${NC}"
    fi
    if [[ $has_pending_review -eq 1 ]]; then
        echo -e "  ${BLUE}3.${NC} 有 pending-review 的变更 → 打开新终端，让 agent 执行 ${BOLD}/review-tests${NC}"
    fi
    if [[ $has_implementing -eq 1 ]]; then
        echo -e "  ${YELLOW}4.${NC} 有 implementing 的变更 → 打开新终端，让 agent 执行 ${BOLD}/continue-change${NC}"
    fi
    if [[ -n "$stale_changes" ]]; then
        warn "以下变更超过 7 天未更新:$stale_changes → 考虑 /check-changes 复查"
    fi
    if [[ $has_review_failed -eq 0 && $has_pending_review -eq 0 && $has_implementing -eq 0 && $has_drafting -eq 0 ]]; then
        echo -e "  ${GREEN}✨${NC} 无进行中变更 → 打开新终端，让 agent 执行 ${BOLD}/new-change${NC} 开始新功能"
    fi
}

# ─── dispatch: 生成 agent 执行提示词 ──────────────────────────────────
cmd_dispatch() {
    local skill="${1:-}"
    if [[ -z "$skill" ]]; then
        echo -e "${BOLD}用法: compass dispatch <skill-name> [args...]${NC}"
        echo ""
        echo "生成一段提示词，复制到新终端的 agent 对话中执行。"
        echo ""
        echo "可用 skill:"
        list_skills
        return 1
    fi

    # 去掉前缀 /
    skill="${skill#/}"
    local skill_file="$SKILLS_DIR/$skill/SKILL.md"

    if [[ ! -f "$skill_file" ]]; then
        error "找不到 skill: $skill"
        echo "可用 skill:"
        list_skills
        return 1
    fi

    shift
    local args="$*"

    header "📋 Agent 执行提示词"
    echo ""
    echo -e "${DIM}将以下内容复制到新终端的 AI agent 对话中：${NC}"
    echo ""
    echo "─────────────── 复制开始 ───────────────"
    echo ""
    if [[ -n "$args" ]]; then
        echo "请执行 /$skill $args"
    else
        echo "请执行 /$skill"
    fi
    echo ""
    echo "─────────────── 复制结束 ───────────────"
    echo ""
    info "提示: 在 Claude Code / Cline / Copilot 的新对话中粘贴即可"
    info "agent 会自动读取 .github/skills/$skill/SKILL.md 并按流程执行"
}

# ─── skills: 列出所有可用 skill ──────────────────────────────────────
cmd_skills() {
    header "🛠️ 可用 Skill"
    list_skills
    echo ""
    echo -e "${DIM}使用方法: compass dispatch <skill-name> [args]${NC}"
}

list_skills() {
    if [[ -d "$SKILLS_DIR" ]]; then
        for d in "$SKILLS_DIR"/*/; do
            local name
            name=$(basename "$d")
            local desc=""
            if [[ -f "$d/SKILL.md" ]]; then
                desc=$(grep '^description:' "$d/SKILL.md" 2>/dev/null | head -1 | sed 's/^description:[[:space:]]*"//;s/"$//' | cut -c1-60)
            fi
            echo -e "  ${BOLD}/$name${NC}  ${DIM}$desc${NC}"
        done
    else
        warn "找不到 $SKILLS_DIR"
    fi
}

# ─── test: 触发远端测试 ──────────────────────────────────────────────
cmd_test() {
    check_ai_dir

    header "🧪 远端测试"

    # 读取 testing.md 中的测试配置
    if [[ -f "$TESTING_FILE" ]]; then
        local test_cmd
        test_cmd=$(grep -oP '(?<=运行命令|test command|run:)[[:space:]]*`[^`]+`' "$TESTING_FILE" 2>/dev/null | head -1 | tr -d '`' | xargs || echo "")

        if [[ -n "$test_cmd" ]]; then
            info "从 testing.md 读取到测试命令: $test_cmd"
        else
            warn "testing.md 中未找到明确的测试运行命令"
        fi
    else
        warn "testing.md 不存在 — 考虑运行 /setup-testing"
    fi

    # 检查远端配置
    local remote_config="$AI_DIR/test-remote.conf"
    if [[ -f "$remote_config" ]]; then
        info "读取远端配置: $remote_config"
        # shellcheck source=/dev/null
        source "$remote_config"
        echo ""
        echo -e "  远端主机: ${BOLD}${TEST_HOST:-未配置}${NC}"
        echo -e "  项目路径: ${BOLD}${TEST_PATH:-未配置}${NC}"
        echo -e "  测试命令: ${BOLD}${TEST_CMD:-未配置}${NC}"
        echo ""

        if [[ -n "${TEST_HOST:-}" && -n "${TEST_PATH:-}" && -n "${TEST_CMD:-}" ]]; then
            echo -e "${YELLOW}即将在远端执行测试...${NC}"
            echo -e "${DIM}ssh $TEST_HOST \"cd $TEST_PATH && $TEST_CMD\"${NC}"
            echo ""
            read -rp "确认执行? (y/N) " confirm
            if [[ "$confirm" =~ ^[Yy]$ ]]; then
                ssh "$TEST_HOST" "cd $TEST_PATH && $TEST_CMD"
            else
                info "已取消"
            fi
        else
            warn "远端配置不完整，请检查 $remote_config"
        fi
    else
        warn "未找到远端测试配置"
        echo ""
        echo -e "  创建 ${BOLD}$remote_config${NC} 来配置远端测试："
        echo ""
        echo "  ─── 示例内容 ───"
        echo '  TEST_HOST="user@192.168.1.100"    # SSH 目标'
        echo '  TEST_PATH="/path/to/project"       # 远端项目路径'
        echo '  TEST_CMD="npm test"                 # 远端测试命令'
        echo '  # TEST_SYNC_CMD="git pull"          # 可选：测试前同步代码'
        echo "  ─────────────────"
    fi
}

# ─── watch: 持续监控模式 ─────────────────────────────────────────────
cmd_watch() {
    local interval="${1:-10}"
    info "监控模式 — 每 ${interval}s 刷新（Ctrl+C 退出）"
    while true; do
        clear
        cmd_status
        echo -e "${DIM}下次刷新: ${interval}s (Ctrl+C 退出)${NC}"
        sleep "$interval"
    done
}

# ─── help ─────────────────────────────────────────────────────────────
cmd_help() {
    echo ""
    echo -e "${BOLD}🧭 compass — Compass Harness 中控台${NC}"
    echo ""
    echo "用法: compass <command> [args...]"
    echo ""
    echo "命令:"
    echo -e "  ${BOLD}status${NC}              全局状态总览（变更、会话、下一步建议）"
    echo -e "  ${BOLD}skills${NC}              列出所有可用 skill"
    echo -e "  ${BOLD}dispatch${NC} <skill>    生成 agent 执行提示词（复制到新终端）"
    echo -e "  ${BOLD}test${NC}                触发远端测试（需配置 .ai/test-remote.conf）"
    echo -e "  ${BOLD}watch${NC} [interval]    持续监控模式（默认 10s 刷新）"
    echo -e "  ${BOLD}help${NC}                显示此帮助"
    echo ""
    echo "工作方式:"
    echo "  compass 是只读的中控台 — 它不执行 skill，只查看状态和生成提示词。"
    echo "  每个 skill 由独立的 AI agent 在独立终端执行："
    echo ""
    echo "    终端 1: compass watch           ← 中控台，持续监控"
    echo "    终端 2: claude code              ← agent 执行 /new-change"
    echo "    终端 3: claude code              ← agent 执行 /review-tests"
    echo "    终端 4: claude code              ← agent 执行 /fix-bug"
    echo ""
    echo "  用 'compass status' 看全局，用 'compass dispatch <skill>' 获取提示词。"
    echo ""
}

# ─── 主入口 ───────────────────────────────────────────────────────────
main() {
    local cmd="${1:-status}"
    shift 2>/dev/null || true

    case "$cmd" in
        status|s)   cmd_status ;;
        skills|sk)  cmd_skills ;;
        dispatch|d) cmd_dispatch "$@" ;;
        test|t)     cmd_test ;;
        watch|w)    cmd_watch "$@" ;;
        help|h|-h|--help) cmd_help ;;
        *)
            error "未知命令: $cmd"
            cmd_help
            exit 1
            ;;
    esac
}

main "$@"
